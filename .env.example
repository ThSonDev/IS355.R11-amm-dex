# Chép thành .env (đã bị gitignore). Chỉ điền placeholder ở file này, không điền key thật.

# --- Local (Anvil) ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
IPFS_API=http://127.0.0.1:5001
IPFS_GATEWAY=http://127.0.0.1:8080

# --- Backend (BE-01) ---
# Key công khai của Anvil (tài khoản #5, vai trò Backend); chỉ dùng cho local
RECEIPT_ISSUER_PRIVATE_KEY=<anvil-account-5-private-key>
# Sinh bằng: python3 -c "import secrets;print(secrets.token_hex(32))"
SERVER_MASTER_KEY=<64-hex-chars>
AUDITOR_PUBLIC_KEY_PATH=<path-to-auditor-public.pem>
PINATA_JWT=<optional-pinata-jwt>

# --- Sepolia (chỉ Lead, DV-21) ---
SEPOLIA_RPC_URL=<sepolia-rpc-url>
DEPLOYER_PRIVATE_KEY=<sepolia-deployer-private-key>
ETHERSCAN_API_KEY=<etherscan-api-key>
